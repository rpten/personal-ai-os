   "steps": [
    {
     "click": "[data-v=dados]"
    },
    {
     "set_files": [
      "#csv",
      "../app/fixtures/ratings.csv"
     ]
    },
    {
     "wait_for": "#csvmsg.ok"
    },
    {
     "click": "[data-v=indicar]"
    },
    {
     "click": "#rec"
    },
    {
     "wait_ms": 600
    }
   ]
  },
  {
