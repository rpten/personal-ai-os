{
 "routes": [
  {
   "match": "**/config.json*",
   "status": 200,
   "json": {
    "workerUrl": "https://taste-memory-recs.simulado.workers.dev"
   }
  },
  {
   "match": "**/data/*.xml*",
   "status": 404,
   "body": ""
  }
 ],
 "flows": [
  {
   "name": "01-primeiro-acesso",
   "path": "/",
   "steps": []
  },
  {
   "name": "02-importacao",
   "path": "/",
   "steps": [
    {
     "click": "[data-v=dados]"
    },
    {
     "set_files": [
      "#csv",
      "../app/fixtures/ratings.csv"
     ]
    },
    {
     "wait_for": "#csvmsg.ok"
    }
   ]
  },
  {
   "name": "03-com-dados",
   "path": "/",
   "steps": [
    {
     "click": "[data-v=dados]"
    },
    {
     "set_files": [
      "#csv",
      "../app/fixtures/ratings.csv"
     ]
    },
    {
     "wait_for": "#csvmsg.ok"
    },
    {
     "click": "[data-v=indicar]"
    }
   ]
  },
  {
   "name": "04-carregando",
   "path": "/",
